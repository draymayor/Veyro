# When true, reads ready_to_sign withdrawals and logs what WOULD be
# signed/broadcast WITHOUT claiming any row (crypto_signing_status is never
# touched) or deriving any key material. Always run a batch of dry runs
# after any change to this job, and before every real manual invocation.
CONSOLIDATOR_DRY_RUN=true

GCP_PROJECT_ID=

# Same Supabase project as apps/api and apps/sweeper, service-role key only
# - this job has no end-user session context.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Needed for the UTXO chains' UTXO/fee/broadcast calls (same Tatum account
# apps/sweeper uses).
TATUM_API_KEY=

# One RPC URL per EVM network label this job might need to pay out on -
# same env var convention as apps/sweeper/.env.example. Network names with
# spaces (e.g. "XDC Network") use an underscore in the env var name.
EVM_RPC_URL_ERC20=
EVM_RPC_URL_BEP20=
EVM_RPC_URL_Polygon=
EVM_RPC_URL_Avalanche=
EVM_RPC_URL_Celo=
EVM_RPC_URL_Flare=
EVM_RPC_URL_Fantom=
EVM_RPC_URL_Cronos=
EVM_RPC_URL_Ethereum_Classic=
EVM_RPC_URL_Kaia=
EVM_RPC_URL_XDC_Network=
EVM_RPC_URL_Arbitrum=
EVM_RPC_URL_Optimism=
EVM_RPC_URL_Base=

# NOTE: no master seed env var here on purpose. CONSOLIDATION_MASTER_SEED is
# read directly from GCP Secret Manager at runtime (src/secret-manager.ts),
# never from a plain env var/.env, and only this job's dedicated service
# account (veyro-consolidator) has secretAccessor on it - not apps/api's
# runtime service account, not apps/sweeper's service account, not even
# this job's own CI deploy identity.
