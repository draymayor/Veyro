PORT=8080

# Same Supabase project as apps/api. Service-role key: block-watcher only
# ever SELECTs user_crypto_addresses (to build its address hash map) - it
# never writes crypto_deposit_events directly, that goes through apps/api's
# /webhooks/block-watcher route instead (see api-client.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of apps/api (no trailing slash), e.g. https://veyro-api-xyz.run.app
API_BASE_URL=
# Must match apps/api's own BLOCK_WATCHER_SHARED_SECRET exactly - a single
# shared secret since both ends are this codebase's own first-party
# services, generated once and given to both.
BLOCK_WATCHER_SHARED_SECRET=

# How often (ms) to re-read user_crypto_addresses into the in-memory address
# map. 60s default per the Strategy 3 design: a same-block deposit to a
# brand-new address created less than one interval ago could be missed until
# the next refresh - accepted as a rare, small timing window (redundant
# Tatum/Alchemy coverage still catches it where that coverage exists).
ADDRESS_MAP_REFRESH_MS=60000

# Poll-only EVM chains (no confirmed free WebSocket provider - see
# chain-config.ts): reuses the SAME env var names apps/sweeper already
# defines, so the same values can be copied over rather than sourcing new
# ones. The WS-covered chains (ERC20, BEP20, Polygon, Avalanche, Arbitrum,
# Optimism, Base) need no RPC URL here - they connect directly to PublicNode.
EVM_RPC_URL_Celo=
EVM_RPC_URL_Flare=
EVM_RPC_URL_Fantom=
EVM_RPC_URL_Cronos=
EVM_RPC_URL_Ethereum_Classic=
EVM_RPC_URL_Kaia=
EVM_RPC_URL_XDC_Network=

# Explicit opt-in for the BTC/LTC/DOGE BlockCypher watchers - leave unset
# (or anything other than exactly "true") until README.md's "Known open
# items" UTXO section is genuinely resolved. EVM detection starts
# regardless of this value - see main.ts.
UTXO_DETECTION_ENABLED=

# Free TronGrid API key (get one at https://www.trongrid.io/dashboard) -
# required, not optional: confirmed live 2026-09-07 that unauthenticated
# TronGrid requests are capped at 1 req/sec, which this service's 3s poll
# interval alone exceeds. Without this set, the TRC20 watcher is held off
# entirely at startup rather than retry-looping against a 429 it can never
# clear - see main.ts.
TRONGRID_API_KEY=
