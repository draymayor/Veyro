PORT=3001

# Web app origin allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:3000

# Web app origin used to build links inside emails (e.g. the welcome
# email's "Get Started" button)
WEB_APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=

# Crypto price feed (CoinGecko, server-side only, never exposed to the frontend)
COINGECKO_API_KEY=

# FX rates for converting crypto payouts to a user's wallet currency
# (server-side only, never exposed to the frontend). Primary provider is
# freecurrencyapi.com; CurrencyFreaks is used automatically as a fallback
# if the primary request fails.
FCA_API_KEY=
CURRENCYFREAKS_API_KEY=

# Tatum (crypto deposit address generation, server-side only). Master
# xpubs are safe to hold here since they can only derive addresses, never
# sign transactions or move funds - the master seeds they're derived from
# live only in GCP Secret Manager, touched once at initial setup, never by
# this running API (see docs/planning-history.md's Crypto Custody
# section). This API holds all 5 master seed groups as xpubs.
#
# TATUM_EVM_XPUB is shared across every EVM-compatible network Veyro
# supports (ERC20, BEP20, Polygon, Avalanche, Celo, Flare, Fantom, Cronos,
# Ethereum Classic, Kaia, XDC Network, Arbitrum, Optimism, Base) - one
# private key produces the identical address on all of them, so one xpub
# covers all of them rather than one per chain.
TATUM_API_KEY=
TATUM_BTC_XPUB=
TATUM_LTC_XPUB=
TATUM_DOGE_XPUB=
TATUM_EVM_XPUB=
TATUM_TRON_XPUB=

# Webhook-based deposit detection (docs/context.md's "hybrid model").
# TATUM_WEBHOOK_URL is the public URL Tatum POSTs deposit notifications to
# (this API's own /webhooks/tatum route) - given to Tatum at subscription-
# creation time. Real cap confirmed directly against the live Tatum
# dashboard (2026-09-04): 5 ADDRESS_TRANSACTION subscriptions total,
# platform-wide, shared across every chain - most addresses will NOT get
# one, and fall back to the existing admin manual-check path, by design.
TATUM_WEBHOOK_URL=
# Must match the hmacSecret set via Tatum's own "enable HMAC" endpoint for
# this API key - a one-time, separate account-level setup step done once
# against Tatum's API directly, not something this app re-sends on boot.
TATUM_WEBHOOK_HMAC_SECRET=

# Alchemy (second webhook provider, covers EVM chains only - Tatum above
# stays exactly as-is for TRON). Address generation for EVM still goes
# through Tatum/TATUM_EVM_XPUB unchanged; only deposit DETECTION for EVM
# chains uses Alchemy instead. Free tier is a hard 5-webhooks-total cap,
# and each Address Activity webhook covers exactly ONE network (no
# multi-chain pipeline exists) - so only 5 of Veyro's 14 EVM chains are
# covered (Ethereum, Polygon, BSC, Arbitrum, Base), chosen without real
# volume data since none exists yet. The rest fall back to the existing
# admin manual-check path, same as BTC/LTC/DOGE always have. Activating an
# additional chain later (once a slot frees up or the account is
# upgraded) is adding one entry to each JSON object below plus an
# `alchemyNetwork` value in chain-config.ts - not a rearchitecture.

# Notify API auth token (from the Alchemy dashboard) - used ONLY to call
# the webhook-management API (adding an address to an existing webhook).
# This is a DIFFERENT value from any of the per-webhook signing keys
# below; it never appears in an inbound webhook delivery.
ALCHEMY_API_KEY=

# One Alchemy Address Activity webhook per active EVM chain, created
# once via the Alchemy dashboard/Notify API (a one-time setup step, not
# something this app creates itself) - keyed by Alchemy's own network
# enum value (see chain-config.ts's alchemyNetwork field), JSON object.
ALCHEMY_WEBHOOK_IDS={"ETH_MAINNET":"","BNB_MAINNET":"","MATIC_MAINNET":"","ARB_MAINNET":"","BASE_MAINNET":""}

# Per-webhook signing key (copied from that webhook's own detail page in
# the Notify dashboard) used to verify X-Alchemy-Signature on inbound
# deliveries - NOT the API key/auth token above. One per webhook, since
# each Alchemy webhook has its own key. Same keyspace as
# ALCHEMY_WEBHOOK_IDS, JSON object.
ALCHEMY_WEBHOOK_SIGNING_KEYS={"ETH_MAINNET":"","BNB_MAINNET":"","MATIC_MAINNET":"","ARB_MAINNET":"","BASE_MAINNET":""}