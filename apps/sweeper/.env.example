# Which schedule invoked this run - set by the Cloud Scheduler job
# definition, not by a human. "utxo" = BTC/LTC/DOGE, 12h cadence.
# "evm" = every EVM chain + TRON, 6h cadence.
SWEEP_GROUP=evm

# When true, computes balances/thresholds and logs what WOULD be swept
# without signing or broadcasting anything. Always run a batch of dry runs
# after any change to thresholds, RPC config, or chain adapters before
# letting a real scheduled run go live.
SWEEP_DRY_RUN=true

GCP_PROJECT_ID=

# Same Supabase project as apps/api, service-role key only - the sweeper
# has no end-user session context.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Needed for the UTXO chains' balance/UTXO/broadcast calls.
TATUM_API_KEY=

# Optional. Used by src/price-feed.ts to convert a live EVM gas-fee
# estimate into USD for the sweep_fee_multiple_erc20_token check
# (thresholds.ts). CoinGecko's public rate limit works without it; set
# this only if runs start getting rate-limited.
COINGECKO_API_KEY=

# One RPC URL per EVM network label. Network names with spaces (e.g. "XDC
# Network") use an underscore in the env var name.
EVM_RPC_URL_ERC20=
EVM_RPC_URL_BEP20=
EVM_RPC_URL_Polygon=
EVM_RPC_URL_Avalanche=
EVM_RPC_URL_Celo=
EVM_RPC_URL_Flare=
EVM_RPC_URL_Fantom=
EVM_RPC_URL_Cronos=
EVM_RPC_URL_Ethereum_Classic=
EVM_RPC_URL_Kaia=
EVM_RPC_URL_XDC_Network=
EVM_RPC_URL_Arbitrum=
EVM_RPC_URL_Optimism=
EVM_RPC_URL_Base=

# NOTE: no master seed env vars here on purpose. All 5 master seeds
# (SWEEPER_BTC_SEED, SWEEPER_LTC_SEED, SWEEPER_DOGE_SEED,
# SWEEPER_EVM_SEED, SWEEPER_TRON_SEED) are read
# directly from GCP Secret Manager at runtime (src/secret-manager.ts),
# never from plain env vars/.env, and only this job's dedicated service
# account has secretAccessor on them - not apps/api's runtime service
# account, not even this job's own CI deploy identity.
